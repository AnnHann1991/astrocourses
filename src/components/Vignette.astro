---
// src/components/Vignette.astro
---
<div class="vignette-wrapper">
    <svg xmlns="http://w3.org" viewBox="0 0 400 40" width="100%" height="100%">
      <defs>
        <!-- Тот же премиальный золотой градиент, что и на основном логотипе -->
        <linearGradient id="vignette-gold" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#8A6421" />
          <stop offset="25%" stop-color="#C5A059" />
          <stop offset="50%" stop-color="#F3E5AB" />
          <stop offset="75%" stop-color="#D4AF37" />
          <stop offset="100%" stop-color="#8A6421" />
        </linearGradient>
      </defs>
  
      <g fill="url(#vignette-gold)">
        <!-- ЦЕНТРАЛЬНЫЙ ЭЛЕМЕНТ: Геральдическая лилия -->
        <!-- Центральный лепесток -->
        <path d="M200,5 C203,15 206,23 206,29 C206,33 203,35 200,35 C197,35 194,33 194,29 C194,23 197,15 200,5 Z" />
        <!-- Левый лепесток -->
        <path d="M200,24 C193,23 186,17 186,24 C186,29 191,33 196,31 C198,30 199,28 200,27 Z" />
        <!-- Правый лепесток -->
        <path d="M200,24 C207,23 214,17 214,24 C214,29 209,33 204,31 C202,30 201,28 200,27 Z" />
        <!-- Поясок лилии -->
        <rect x="193" y="25" width="14" height="2" rx="1" />
  
        <!-- ЛЕВОЕ КРЫЛО (Завитки и сужающаяся линия) -->
        <!-- Усик и капля слева -->
        <path d="M190,27 C175,28 160,20 145,21 C130,22 115,28 100,25 C70,20 40,22 10,22 L10,21 C40,21 70,19 100,24 C115,26 130,20 145,19 C162,18 177,27 190,25 Z" />
        <!-- Крученый волюта-завиток слева -->
        <path d="M155,20 C150,15 142,15 140,20 C138,24 143,27 147,25 C150,23 149,19 146,19 C144,19 143,21 144,22 C145,22 146,21 146,20 C146,18 142,18 141,21 C142,23 147,23 149,20 C151,17 146,12 139,15 C132,18 134,27 141,29 C148,31 155,26 155,20 Z" opacity="0.85" />
        <!-- Маленький ромб-точка на левом хвосте -->
        <polygon points="10,21.5 13,20 16,21.5 13,23" />
  
        <!-- ПРАВОЕ КРЫЛО (Зеркальное отображение левого) -->
        <!-- Усик и капля справа -->
        <path d="M210,27 C225,28 240,20 255,21 C270,22 285,28 300,25 C330,20 360,22 390,22 L390,21 C360,21 330,19 300,24 C285,26 270,20 255,19 C238,18 223,27 210,25 Z" />
        <!-- Крученый волюта-завиток справа -->
        <path d="M245,20 C250,15 258,15 260,20 C262,24 257,27 253,25 C250,23 251,19 254,19 C256,19 257,21 256,22 C255,22 254,21 254,20 C254,18 258,18 259,21 C258,23 253,23 251,20 C249,17 254,12 261,15 C268,18 266,27 259,29 C252,31 245,26 245,20 Z" opacity="0.85" />
        <!-- Маленький ромб-точка на правом хвосте -->
        <polygon points="390,21.5 387,20 384,21.5 387,23" />
      </g>
    </svg>
  </div>
  
  <style>
    .vignette-wrapper {
      display: block;
      width: 100%;
      max-width: 250px; /* Идеальная ширина разделителя под текстом */
      margin: 24px auto; /* Автоматическое центрирование и отступы сверху/снизу */
      opacity: 0.75; /* Делаем чуть приглушенным, чтобы не отвлекал от чтения */
      transition: opacity 0.3s ease;
    }
  
    /* Мягкая подсветка при чтении/наведении */
    .vignette-wrapper:hover {
      opacity: 1;
    }
  </style>
  