---
interface Props {
  title: string;
  pubDate: string;
  excerpt: string;
  url: string;
};
const { title, pubDate, excerpt, url} = Astro.props;
---

<div class="newscardwrap">
    <a href={url}>
        <div class="newscard">
            <div class="newscard__header">{title}</div>
            <div class="newscard__contentpreview">
                {excerpt}
            </div>
            <div class="newscard__info">
                {new Date(pubDate).toLocaleDateString('ru-RU', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                })}
            </div>
        </div>
    </a>
</div>

<style>
    .newscardwrap {
        padding-bottom: 16px;
    }
    .newscard {
        border-radius: 8px;
        border: 1px solid lightgray;
        background-image: linear-gradient(#373e52, #adb8ce);
        margin-right: -6px;
        margin-left: -6px;
    }
    .newscard__header {
        padding: 8px 24px;
        color: #F3E5AB;
    }
    .newscard__contentpreview {
        background-color: #fff;
        padding: 8px 24px;
    }
    .newscard__info {
        color: rgb(47, 47, 48);
        padding: 8px 24px;
    }
</style>