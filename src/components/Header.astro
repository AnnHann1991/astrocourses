---
import Logo from './Logo.astro';
---


<header class="header">
   <div class="header__darken"></div>
   <div class="container">
        <nav id="header-nav" class="header-nav">
            <a href="/" class="logo-wrapper">
                <Logo />
              </a>
            <ul class="header-nav__list">
                <li class="header-nav__list-item"><a href="/about">О нас</a></li>
                <li class="header-nav__list-item"><a href="/schedule">Расписание</a></li>
                <li class="header-nav__list-item"><a href="/news">Новости</a></li>
                <li class="header-nav__list-item"><a href="/gallery">Галерея</a></li>
            </ul> 
        </nav>
    </div> 
</header>

<style>
    .header {
        display: flex;
        align-items: center;
        height: 160px;
        position: fixed;
        top: 0;
        right: 0;
        left: 0;
        background-color: burlywood;
        background-image: linear-gradient(rgba(0, 0, 0, 0.6) 80%, rgba(106, 107, 107, 0.8)),
      url('../assets/dumska_bg.jpg');
        background-size: cover;
        background-position: top center;
        background-repeat: no-repeat;
        z-index: 100;
    }
    .header-nav {
        display: flex;
        gap: 36px;
        align-items: center;
    }
    .header-nav__list {
        display: flex;
        flex-direction: row;
        gap: 24px;
        align-items: center;
    }
    .header-nav__list-item {
        color: rgb(65, 182, 182);
        position: relative;
    }
    .header-nav__list-item::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0%;
        height: 2px;
        background: rgb(83, 231, 231);
        transition: all 0.3s;
    }
    .header-nav__list-item:hover {
        color: rgb(83, 231, 231);
        transition: all 0.3s;
    }
    .header-nav__list-item:hover::after {
        width: 100%;
        transition: all 0.3s;
    }
    .header-nav__list-item:focus {
        color: rgb(83, 231, 231);
        transition: all 0.3s;
    }
    .header-nav__list-item:focus::after {
        width: 100%;
        transition: all 0.3s;
    }
</style>